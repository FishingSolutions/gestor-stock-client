# ── Supabase ────────────────────────────────────────────────────────────────
# Copiá este archivo a .env y completá los valores de tu proyecto.
# Dashboard de Supabase → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# La URL tiene el formato: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Usá la "anon key" (JWT) o la "publishable key" (sb_publishable_...).
# Es pública por diseño; NUNCA pongas acá la service_role key.
VITE_SUPABASE_ANON_KEY=
